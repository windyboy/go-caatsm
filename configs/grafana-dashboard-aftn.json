      "description": "Message processing throughput by status",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Messages/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
